# Copy to .env and fill in. Generate a master key with: rustllmroute generate-master-key
LITELLM_MASTER_KEY=sk-change-me
DATABASE_URL=sqlite:///data/rustllmroute.db
PORT=4000
HOST=0.0.0.0
LITELLM_LOG=info

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
