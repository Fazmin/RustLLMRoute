OPENROUTER_API_KEY=
AZURE_API_KEY=
AZURE_API_BASE=

UI_USERNAME=admin
UI_PASSWORD=

OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=rustllmroute
